generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  logo        String
  description String
  country     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                  Int                  @id @default(autoincrement())
  name                String
  slug                String               @unique
  description         String
  image               String
  backgroundImage     String?
  volume              String?
  alcoholPercentage   String?
  country             String?
  category            String
  flavors             String?
  grapeVarietal       String?
  tastingNotes        String?
  region              String?
  servingSuggestion   String?
  awards              String[]
  pairings            String[]
  highlights          String[]
  isFeatured          Boolean              @default(false)
  featuredImage       String?
  featuredOrder       Int?
  brandId             Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  cocktailIngredients CocktailIngredient[]
  brand               Brand                @relation(fields: [brandId], references: [id])
}

model Cocktail {
  id            Int                  @id @default(autoincrement())
  title         String
  slug          String               @unique
  description   String
  imageUrl      String
  difficulty    CocktailDifficulty
  category      String
  base          String
  method        String
  garnish       String?
  isFeatured    Boolean              @default(false)
  featuredOrder Int?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  ingredients   CocktailIngredient[]
}

model CocktailIngredient {
  id         Int      @id @default(autoincrement())
  cocktailId Int
  name       String
  amount     String
  order      Int      @default(0)
  productId  Int?
  cocktail   Cocktail @relation(fields: [cocktailId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])
}

model CarouselSlide {
  id        Int      @id @default(autoincrement())
  image     String
  altText   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyStat {
  id        Int      @id @default(autoincrement())
  value     String
  label     String
  icon      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInfo {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  value     String
  subValue  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CocktailDifficulty {
  Easy
  Medium
  Advanced
}
